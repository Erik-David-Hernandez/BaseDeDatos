<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/11" xmlns:fx="http://javafx.com/fxml/1" fx:controller="basedatos.controllers.UsuarioController">
    <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>

    <top>
        <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-padding: 0 0 10 0;">
            <Label fx:id="lblBienvenida" text="Panel de Lector" style="-fx-font-size: 17px; -fx-font-weight: bold;" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <Button text="Cerrar Sesión" onAction="#cerrarSesion" styleClass="button-danger"/>
        </HBox>
    </top>

    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">
            <Tab text="Catálogo y Reservas">
                <VBox spacing="10" style="-fx-padding: 12;">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Buscar (Título, Autor o Género):"/>
                        <TextField fx:id="txtBuscar" promptText="Ej. Cien años, Gabriel, Fantasía..." prefWidth="320" onAction="#buscarLibros"/>
                        <Button text="Buscar" onAction="#buscarLibros"/>
                        <Button text="Mostrar Todos" onAction="#limpiarBusqueda"/>
                    </HBox>

                    <TableView fx:id="tablaLibros" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn text="ID" fx:id="colId" prefWidth="55"/>
                            <TableColumn text="Título" fx:id="colTitulo" prefWidth="240"/>
                            <TableColumn text="Autor" fx:id="colAutor" prefWidth="180"/>
                            <TableColumn text="Género" fx:id="colGenero" prefWidth="150"/>
                            <TableColumn text="Sección" fx:id="colSeccion" prefWidth="105"/>
                            <TableColumn text="Disponibilidad" fx:id="colDisp" prefWidth="130"/>
                        </columns>
                    </TableView>

                    <HBox spacing="12" alignment="CENTER_RIGHT" styleClass="card">
                        <Label text="Fecha recogida:"/>
                        <DatePicker fx:id="dpFechaRecogida" prefWidth="135"/>
                        <Label text="Días préstamo:"/>
                        <Spinner fx:id="spDiasPrestamo" prefWidth="75"/>
                        <Button text="Reservar Libro Seleccionado" onAction="#reservarLibro" styleClass="button-success"/>
                    </HBox>
                </VBox>
            </Tab>

            <Tab text="Mi Historial de Préstamos y Reservas">
                <VBox spacing="10" style="-fx-padding: 12;">
                    <TableView fx:id="tablaHistorial" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn text="Folio" fx:id="colHistId" prefWidth="70"/>
                            <TableColumn text="Libro" fx:id="colHistLibro" prefWidth="280"/>
                            <TableColumn text="Fecha Inicio" fx:id="colHistInicio" prefWidth="160"/>
                            <TableColumn text="Fecha Devolución" fx:id="colHistFin" prefWidth="160"/>
                            <TableColumn text="Estado" fx:id="colHistEstado" prefWidth="120"/>
                        </columns>
                    </TableView>
                    <HBox alignment="CENTER_RIGHT">
                        <Label text="Solo se puede cancelar antes de la fecha de recogida." HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <Button fx:id="btnCancelarReserva" text="Cancelar Reserva Seleccionada" onAction="#cancelarReserva" styleClass="button-danger" disable="true"/>
                    </HBox>
                </VBox>
            </Tab>
        </TabPane>
    </center>
</BorderPane>
