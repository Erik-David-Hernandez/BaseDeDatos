<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="basedatos.UsuarioController">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
    
    <top>
        <VBox spacing="15">
            <BorderPane>
                <left><Label text="Panel de Lector - Buscar y Reservar" style="-fx-font-size: 18px; -fx-font-weight: bold;" BorderPane.alignment="CENTER"/></left>
                <right><Button text="Cerrar Sesión" onAction="#cerrarSesion" BorderPane.alignment="CENTER"/></right>
            </BorderPane>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Buscar Libro: "/>
                <TextField prefWidth="300"/>
                <Button text="Buscar"/>
            </HBox>
        </VBox>
    </top>
    
    <center>
        <TableView fx:id="tablaLibros" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn text="ID" fx:id="colId" prefWidth="100"/>
                <TableColumn text="Título" fx:id="colTitulo" prefWidth="200"/>
                <TableColumn text="Autor" fx:id="colAutor" prefWidth="150"/>
                <TableColumn text="Disponibilidad" fx:id="colDisp" prefWidth="150"/>
            </columns>
            <BorderPane.margin><Insets top="15" bottom="15"/></BorderPane.margin>
        </TableView>
    </center>
    
    <bottom>
        <HBox spacing="10" alignment="CENTER_RIGHT">
            <Button text="Ver Mi Historial" onAction="#verHistorial"/>
            <Button text="Reservar Libro Seleccionado" onAction="#reservarLibro"/>
        </HBox>
    </bottom>
</BorderPane>