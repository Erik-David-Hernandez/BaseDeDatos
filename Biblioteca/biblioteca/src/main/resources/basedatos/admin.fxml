<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="basedatos.AdminController">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
    
    <top>
        <BorderPane>
            <left><Label text="Panel de Administración" style="-fx-font-size: 18px; -fx-font-weight: bold;" BorderPane.alignment="CENTER"/></left>
            <right><Button text="Cerrar Sesión" onAction="#cerrarSesion" BorderPane.alignment="CENTER"/></right>
        </BorderPane>
    </top>
    
    <center>
        <GridPane hgap="20" vgap="20" alignment="CENTER">
            <Button text="Gestión de Libros" prefWidth="200" prefHeight="100" GridPane.columnIndex="0" GridPane.rowIndex="0" onAction="#accionAdmin"/>
            <Button text="Gestión de Usuarios" prefWidth="200" prefHeight="100" GridPane.columnIndex="1" GridPane.rowIndex="0" onAction="#accionAdmin"/>
            <Button text="Ver Préstamos Activos" prefWidth="200" prefHeight="100" GridPane.columnIndex="0" GridPane.rowIndex="1" onAction="#accionAdmin"/>
            <Button text="Configuración" prefWidth="200" prefHeight="100" GridPane.columnIndex="1" GridPane.rowIndex="1" onAction="#accionAdmin"/>
        </GridPane>
    </center>
</BorderPane>