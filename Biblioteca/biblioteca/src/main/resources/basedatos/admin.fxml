<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/11" xmlns:fx="http://javafx.com/fxml/1" fx:controller="basedatos.controllers.AdminController">
    <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>

    <top>
        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 0 0 10 0;">
            <Label fx:id="lblAdmin" text="Panel de Administración" style="-fx-font-size: 17px; -fx-font-weight: bold;" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <Button text="Recargar datos" onAction="#recargarTodo"/>
            <Button text="Cerrar Sesión" onAction="#cerrarSesion" styleClass="button-danger"/>
        </HBox>
    </top>

    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">
            <!-- TAB 1: GESTIÓN DE LIBROS, GÉNEROS Y AUTORES -->
            <Tab text="Libros, Géneros y Autores">
                <VBox spacing="10" style="-fx-padding: 10;">
                    <HBox spacing="10">
                        <!-- Formulario Nuevo Libro -->
                        <VBox spacing="6" styleClass="card" HBox.hgrow="ALWAYS">
                            <Label text="Agregar Nuevo Libro" style="-fx-font-weight: bold;"/>
                            <HBox spacing="8">
                                <TextField fx:id="txtTituloLibro" promptText="Título del libro" HBox.hgrow="ALWAYS"/>
                                <TextField fx:id="txtIsbnLibro" promptText="ISBN (ej. 978-...)" prefWidth="140"/>
                                <TextField fx:id="txtSeccionLibro" promptText="Sección (SEC-...)" prefWidth="115"/>
                            </HBox>
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <ComboBox fx:id="cbAutorLibro" promptText="Seleccionar Autor" prefWidth="180"/>
                                <ComboBox fx:id="cbGeneroLibro" promptText="Seleccionar Género" prefWidth="170"/>
                                <Label text="Ejemplares:"/>
                                <Spinner fx:id="spEjemplaresLibro" prefWidth="70"/>
                                <Button text="Guardar Libro" onAction="#agregarLibro" styleClass="button-success"/>
                            </HBox>
                        </VBox>
                    </HBox>

                    <HBox spacing="10">
                        <!-- Nuevo Género -->
                        <HBox spacing="8" alignment="CENTER_LEFT" styleClass="card" HBox.hgrow="ALWAYS">
                            <Label text="Nuevo Género:" style="-fx-font-weight: bold;"/>
                            <TextField fx:id="txtNuevoGenero" promptText="Nombre del género" HBox.hgrow="ALWAYS"/>
                            <Button text="Agregar" onAction="#agregarGenero"/>
                        </HBox>
                        <!-- Nuevo Autor -->
                        <HBox spacing="8" alignment="CENTER_LEFT" styleClass="card" HBox.hgrow="ALWAYS">
                            <Label text="Nuevo Autor:" style="-fx-font-weight: bold;"/>
                            <TextField fx:id="txtAutorNombres" promptText="Nombres" prefWidth="105"/>
                            <TextField fx:id="txtAutorApellidoP" promptText="Ap. Paterno" prefWidth="105"/>
                            <TextField fx:id="txtAutorApellidoM" promptText="Ap. Materno" prefWidth="105"/>
                            <Button text="Agregar" onAction="#agregarAutor"/>
                        </HBox>
                    </HBox>

                    <Label text="Doble clic en un libro para editarlo."/>
                    <TableView fx:id="tablaAdminLibros" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn text="ID" fx:id="colLibId" prefWidth="55"/>
                            <TableColumn text="Título" fx:id="colLibTitulo" prefWidth="240"/>
                            <TableColumn text="ISBN" fx:id="colLibIsbn" prefWidth="135"/>
                            <TableColumn text="Autor" fx:id="colLibAutor" prefWidth="180"/>
                            <TableColumn text="Género" fx:id="colLibGenero" prefWidth="150"/>
                            <TableColumn text="Ejemplares" fx:id="colLibEjemplares" prefWidth="90"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>

            <!-- TAB 2: GESTIÓN DE PRÉSTAMOS -->
            <Tab text="Préstamos y Reservas">
                <VBox spacing="10" style="-fx-padding: 10;">
                    <TextField fx:id="txtBuscarPrestamos" promptText="Buscar por nombre del lector, correo o título del libro"/>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="Inicio desde:"/>
                        <DatePicker fx:id="dpPrestamosDesde" prefWidth="150"/>
                        <Label text="hasta:"/>
                        <DatePicker fx:id="dpPrestamosHasta" prefWidth="150"/>
                        <Button text="Limpiar filtros" onAction="#limpiarFiltrosPrestamos"/>
                        <Label fx:id="lblFiltroPrestamos" wrapText="true"/>
                    </HBox>
                    <TableView fx:id="tablaAdminPrestamos" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn text="ID" fx:id="colPresId" prefWidth="60"/>
                            <TableColumn text="Usuario" fx:id="colPresUsuario" prefWidth="180"/>
                            <TableColumn text="Libro" fx:id="colPresLibro" prefWidth="240"/>
                            <TableColumn text="Inicio" fx:id="colPresInicio" prefWidth="140"/>
                            <TableColumn text="Fin" fx:id="colPresFin" prefWidth="140"/>
                            <TableColumn text="Estado" fx:id="colPresEstado" prefWidth="110"/>
                        </columns>
                    </TableView>
                    <HBox spacing="10" alignment="CENTER_RIGHT">
                        <Button text="Cancelar préstamo" onAction="#cancelarPrestamo" styleClass="button-danger"/>
                        <Button text="Marcar como Prestado (Entregado)" onAction="#marcarPrestado"/>
                        <Button text="Marcar como Devuelto" onAction="#marcarDevuelto" styleClass="button-success"/>
                    </HBox>
                </VBox>
            </Tab>

            <!-- TAB 3: GESTIÓN DE USUARIOS -->
            <Tab text="Gestión de Usuarios">
                <VBox spacing="10" style="-fx-padding: 10;">
                    <TableView fx:id="tablaAdminUsuarios" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn text="ID" fx:id="colUsrId" prefWidth="60"/>
                            <TableColumn text="Nombre" fx:id="colUsrNombre" prefWidth="220"/>
                            <TableColumn text="Correo" fx:id="colUsrEmail" prefWidth="240"/>
                            <TableColumn text="Rol" fx:id="colUsrRol" prefWidth="140"/>
                            <TableColumn text="Estado" fx:id="colUsrEstado" prefWidth="120"/>
                        </columns>
                    </TableView>
                    <Label text="Solo los administradores pueden modificar usuarios."/>
                    <HBox fx:id="panelEdicionUsuarios" spacing="12" alignment="CENTER_RIGHT" styleClass="card">
                        <Label text="Rol:"/>
                        <ComboBox fx:id="cbRolUsuario" prefWidth="150"/>
                        <CheckBox fx:id="chkUsuarioActivo" text="Usuario Activo"/>
                        <Button text="Guardar Cambios" onAction="#guardarCambiosUsuario" styleClass="button-success"/>
                    </HBox>
                </VBox>
            </Tab>

            <!-- TAB 4: AUDITORÍA -->
            <Tab text="Auditoría del Sistema">
                <VBox spacing="10" style="-fx-padding: 10;">
                    <TableView fx:id="tablaAuditoria" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn text="ID" fx:id="colAudId" prefWidth="55"/>
                            <TableColumn text="Usuario" fx:id="colAudUsuario" prefWidth="150"/>
                            <TableColumn text="Acción" fx:id="colAudAccion" prefWidth="160"/>
                            <TableColumn text="Tabla" fx:id="colAudTabla" prefWidth="100"/>
                            <TableColumn text="Detalle" fx:id="colAudDetalle" prefWidth="260"/>
                            <TableColumn text="Fecha y Hora" fx:id="colAudFecha" prefWidth="145"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>
        </TabPane>
    </center>
</BorderPane>
