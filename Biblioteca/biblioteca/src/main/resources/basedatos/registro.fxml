<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.TextFlow?>

<VBox alignment="CENTER" spacing="14.0" xmlns="http://javafx.com/javafx/11" xmlns:fx="http://javafx.com/fxml/1" fx:controller="basedatos.controllers.RegistroController">
    <padding><Insets bottom="25.0" left="25.0" right="25.0" top="25.0"/></padding>

    <VBox alignment="CENTER" spacing="10.0" maxWidth="400" styleClass="card">
        <StackPane maxWidth="Infinity">
            <Label text="Registro de Nuevo Lector" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1976D2;"/>
            <Button text="‹" onAction="#volverLogin" styleClass="button-back" prefWidth="32" minWidth="32" prefHeight="32"
                    StackPane.alignment="CENTER_LEFT" accessibleText="Volver al inicio de sesión"/>
        </StackPane>

        <VBox spacing="4" alignment="CENTER_LEFT">
            <HBox spacing="3"><Label text="Nombre completo:"/><Label text="*" styleClass="required-mark" accessibleText="Obligatorio"/></HBox>
            <TextField fx:id="txtNombre" promptText="Nombre y apellidos" maxWidth="Infinity"/>
        </VBox>

        <VBox spacing="4" alignment="CENTER_LEFT">
            <HBox spacing="3"><Label text="Correo electrónico:"/><Label text="*" styleClass="required-mark" accessibleText="Obligatorio"/></HBox>
            <TextField fx:id="txtEmail" promptText="correo@ejemplo.com" maxWidth="Infinity"/>
        </VBox>

        <VBox spacing="4" alignment="CENTER_LEFT">
            <HBox spacing="3"><Label text="Contraseña (mín. 6 caracteres):"/><Label text="*" styleClass="required-mark" accessibleText="Obligatorio"/></HBox>
            <PasswordField fx:id="txtPassword" maxWidth="Infinity"/>
        </VBox>

        <VBox spacing="4" alignment="CENTER_LEFT">
            <HBox spacing="3"><Label text="Confirmar contraseña:"/><Label text="*" styleClass="required-mark" accessibleText="Obligatorio"/></HBox>
            <PasswordField fx:id="txtConfirmarPassword" maxWidth="Infinity"/>
            <Label fx:id="lblErrorPassword" text="Las contraseñas no coinciden." visible="false" managed="false"
                   wrapText="true" style="-fx-text-fill: #D32F2F;"/>
        </VBox>

        <HBox spacing="5" alignment="CENTER_LEFT">
            <CheckBox fx:id="chkPrivacidad" accessibleText="Acepto el aviso de privacidad y protección de datos (LFPDPPP)"/>
            <TextFlow fx:id="textoPrivacidad" HBox.hgrow="ALWAYS" minWidth="0" onMouseClicked="#alternarPrivacidad" style="-fx-cursor: hand;">
                <Text text="${chkPrivacidad.accessibleText}"/>
                <Text text="&#160;*" fill="#D32F2F" styleClass="required-mark" accessibleText="Obligatorio"/>
            </TextFlow>
        </HBox>

        <HBox spacing="10" alignment="CENTER">
            <Button fx:id="btnRegistrar" text="Registrarme" onAction="#registrarUsuario" prefWidth="150" disable="true" defaultButton="true"/>
        </HBox>
    </VBox>
</VBox>
